# Enables Claude-generated answers and the Claude extraction pipeline. Without it the
# engine runs fully offline in extractive mode (rule-based extraction, quoted answers).
ANTHROPIC_API_KEY=
# Optional model overrides (default: claude-opus-5-5)
# EMBER_ANSWER_MODEL=claude-opus-5-5
# EMBER_EXTRACT_MODEL=claude-opus-5-5
# Comma-separated origins allowed to call the API directly (only needed if the web app
# talks to the API cross-origin via NEXT_PUBLIC_API_URL)
# EMBER_CORS=https://your-app.vercel.app
# api.nasa.gov key (https://api.nasa.gov/) for TechPort / TechTransfer pulls. Optional:
# unset falls back to the rate-limited DEMO_KEY. NTRS needs no key.
NASA_API_KEY=

# Google Gemini (free tier works: https://aistudio.google.com/apikey). If both Gemini and Anthropic
# keys are set, Gemini is used; force one with EMBER_LLM=gemini|claude.
GEMINI_API_KEY=
# EMBER_GEMINI_MODEL=gemini-flash-latest
# EMBER_LLM=gemini
